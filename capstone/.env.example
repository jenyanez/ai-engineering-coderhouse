# Configuración del Servidor y API
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# OpenAI API Key (Obligatorio para LLM y Embeddings)
OPENAI_API_KEY=tu_openai_api_key_aqui
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Redis (Message Broker y Checkpointer de LangGraph)
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=intelligence_tasks_queue
REDIS_STATUS_PREFIX=intelligence_status:
REDIS_CHECKPOINT_PREFIX=intelligence_checkpoint:

# Arize Phoenix (Observabilidad y Trazado OpenTelemetry)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=intelligence-production-system

# Base de datos vectorial persistente (ChromaDB)
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=intelligence_knowledge_base
